# ─────────────────────────────────────────────────────
#  .gitignore — MedControl
# ─────────────────────────────────────────────────────

# Ambientes virtuais Python
.venv/
venv/
env/
ENV/

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribuição / empacotamento
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Pytest / cobertura
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Dados gerados pela aplicação (não versionar dados pessoais)
data/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log

# Variáveis de ambiente
.env
.env.*
